[Unit]
Description=Ax3l ax3l-server
After=network.target mariadb.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=@APP@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=@CONFIG@/database.env
ExecStart=@APP@/.venv/bin/python -m ax3l.server.Ax3lServer --zmq-endpoint @AX3L_ZMQ_ENDPOINT@
KillSignal=SIGINT
SuccessExitStatus=130
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
