[Unit]
Description=Ax3l qwen-server (@ENV@)
After=network.target phi-server@SUFFIX@.service
Conflicts=phi-server@SUFFIX@.service

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@APP@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@QWEN_COMMAND@
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
