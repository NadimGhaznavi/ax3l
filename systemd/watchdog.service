[Unit]
Description=Ax3l watchdog (@ENV@)
After=ax3l-server@SUFFIX@.service qwen-server@SUFFIX@.service phi-server@SUFFIX@.service qwenv-server@SUFFIX@.service

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@APP@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m ax3l.server.Watchdog --ax3l-unit ax3l-server@SUFFIX@.service --llm-health-url http://127.0.0.1:@LLM_PORT@/health
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
