[Unit]
Description=Ax3l watchdog
After=ax3l-server.service qwen-server.service phi-server.service qwen2.5-server.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=@APP@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m ax3l.server.Watchdog --ax3l-unit ax3l-server.service --llm-unit @MODEL@-server.service --report-unit reporting-server.service --llm-health-url @LLM_URL@/health
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
